# Local Docker PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=cyclesmart
POSTGRES_USER=cyclesmart
POSTGRES_PASSWORD=cyclesmart_local_password
POSTGRES_SSL=false

# Coolify PostgreSQL:
# Option A: use the internal URL if Coolify gives one
# DATABASE_URL=postgres://postgres:<coolify-password>@<internal-postgres-host>:5432/postgres
#
# Option B: use separate values
# POSTGRES_HOST=<internal-postgres-host>
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<coolify-password>
#
# Coolify internal PostgreSQL usually does not use SSL.
# POSTGRES_SSL=false

SESSION_SECRET=generate-a-random-secret-with-openssl-rand-base64-32

# Email / password reset
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM_EMAIL=contact@example.com

# Optional, useful in production so reset links use the public URL.
# APP_URL=https://cyclesmart.example.com
